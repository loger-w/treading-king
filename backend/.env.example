# 富邦 Neo API（v2.2.7+ API Key 登入）
# 從富邦 TradeAPI 開戶平台申請：https://www.fbs.com.tw/TradeAPI/docs/key-management

# 身分證字號（apikey_login / apikey_dma_login 都需要）
FUBON_PERSONAL_ID=
# API Key
FUBON_API_KEY=

# 電子交易憑證(PFX)— 若只用 DMA 行情可留空
# 即時監控不下單 → 走 apikey_dma_login,不需憑證
FUBON_CERT_PATH=
FUBON_CERT_PASS=

# 身分證字號 fallback（FUBON_PERSONAL_ID 為空時讀這個）
FUBON_ACCOUNT=

# BFF X-API-Key（dev 用 obscurity）
# 隨機產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_API_KEY=

# Discord Webhook（系統異常 alerts，與訊號用的可分開）
ALERTS_DISCORD_WEBHOOK_URL=

# 訊號觸發 Discord webhook（跟 ALERTS_DISCORD_WEBHOOK_URL 分開,可同 URL 也可分流）
SIGNALS_DISCORD_WEBHOOK_URL=

# Frontend dev origin（CORS allowlist 加在 localhost:5173 之外）
FRONTEND_ORIGIN=

# Fubon REST rate limit (token bucket, req/s)
FUBON_RATE_LIMIT_PER_SEC=5

# Fubon historical API rate limit (官方 60 req/min)
FUBON_HISTORICAL_RATE_LIMIT_PER_SEC=1
