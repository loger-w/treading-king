# 富邦 Neo API（v2.2.7+ API Key 登入）
# 從富邦 TradeAPI 開戶平台申請：https://www.fbs.com.tw/TradeAPI/docs/key-management

# 身分證字號（apikey_login / apikey_dma_login 都需要）
FUBON_PERSONAL_ID=
# API Key
FUBON_API_KEY=

# 電子交易憑證（PFX）— 若只用 DMA 行情可留空
# 篩股工具不下單 → 走 apikey_dma_login，不需憑證
FUBON_CERT_PATH=
FUBON_CERT_PASS=

# 帳密 fallback（apikey_login 失敗時走 sdk.login）
FUBON_ACCOUNT=
FUBON_PASSWORD=

# Supabase（從 supabase.com 專案 settings 拿）
SUPABASE_URL=
SUPABASE_KEY=

# BFF X-API-Key（dev 用 obscurity）
# 隨機產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_API_KEY=

# Discord Webhook（系統異常 alerts，與訊號用的可分開）
ALERTS_DISCORD_WEBHOOK_URL=

# Signal engine 調校（Phase 3 才用，先放著）
BOUNDED_QUEUE_SIZE=5000
